# Copy to .env.local for local work. Only the publishable key is read by the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=
# Local guest-side development only (see SETUP.md). Never set on Vercel.
# LOCAL_PG_URL=postgres://postgres:postgres@localhost/bunting_test

# Migrations only, from a developer's machine or a Claude Code session. A personal access token
# from https://supabase.com/dashboard/account/tokens, used by scripts/supabase-sql.py. Revocable
# in one click, and never read by the app.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
