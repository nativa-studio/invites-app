# Airtable personal access token. Create one at https://airtable.com/create/tokens
# with scopes data.records:read and data.records:write, and give it access to the Birthday RSVP base.
AIRTABLE_TOKEN=pat...

# The base ID (starts with "app"). Find it in the Airtable URL or via https://airtable.com/api
AIRTABLE_BASE_ID=appgkbarSE8clnb4u

# Table names. Only change these if you rename the tables in Airtable.
AIRTABLE_GUESTS_TABLE=Guests
AIRTABLE_EVENT_TABLE=Event

# Password for the /host dashboard. Pick anything you like.
HOST_PASSWORD=change-me

# Public URL of the deployed app, no trailing slash. Used to build the invite links.
# Optional: if left blank the app works it out from the incoming request.
NEXT_PUBLIC_SITE_URL=
